# Django
DEBUG=True
# Generate a strong random key for production (placeholder below is safe for dev).
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL on Neon in production; SQLite works out of the box for dev).
# For Neon, use your connection string with SSL, e.g.
#   postgres://user:pass@host:5432/trustfund?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Connection reuse / health checks (production Postgres; no-ops on SQLite)
CONN_MAX_AGE=60
CONN_HEALTH_CHECKS=True

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run tasks synchronously in development (no worker process needed)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES_EXCEPTIONS=True

# CORS (React frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (console backend during development)
EMAIL_URL=console://

# Razorpay — use TEST keys during development, never live keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Cloudinary media storage (production only). Leave disabled locally — media
# stays on the local filesystem. Credentials are AWS/Cloudinary secrets; never
# commit real values.
CLOUDINARY_STORAGE_ENABLED=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production security (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False