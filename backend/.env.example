# Django
DEBUG=True
# Generate a strong random key for production (placeholder below is safe for dev).
SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL in production; SQLite works out of the box for dev)
DATABASE_URL=postgres://user:password@localhost:5432/trustfund

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run tasks synchronously in development (no worker process needed)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES_EXCEPTIONS=True

# CORS (React frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (console backend during development)
EMAIL_URL=console://

# Razorpay — use TEST keys during development, never live keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Production security (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False