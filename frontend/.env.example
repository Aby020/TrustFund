# TrustFund frontend environment (Vite)
# Copy this file to `.env` for local development.
# Placeholder values only — never commit real credentials.

# Base URL of the Django REST API (defaults to http://localhost:8000 when unset)
VITE_API_BASE_URL=http://localhost:8000

# Razorpay Key ID used by the donate page checkout.
# Use a Razorpay TEST key for development, never a live key.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxx