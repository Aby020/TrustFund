{
  "name": "trustfund-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TrustFund frontend — a donation platform for verified charities.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
